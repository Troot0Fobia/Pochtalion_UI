# syntax=docker/dockerfile:1
#
# Linux build environment for Pochtalion.
#
# Contains NO Python and NO application dependencies - those are installed
# at build time from the hash-locked requirement files, so the build inputs
# are exactly what is committed to the repo.

FROM debian:bookworm-slim

# Pinned uv. Must match the uv used to generate the locks, or resolution can
# differ. Keep in sync with build/PYTHON_VERSION's toolchain expectations.
ARG UV_VERSION=0.12.10

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_NO_MODIFY_PATH=1

# Qt 6 / QtWebEngine shared-library dependencies. PyInstaller's binary analysis
# needs to resolve these at build time; the target host is expected to provide
# them (the AppImage bundles the redistributable subset). `file` is required
# by appimagetool (build/appimage.sh), not by PyInstaller itself.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl \
        binutils file \
        libglib2.0-0 libgl1 libegl1 libopengl0 libdrm2 libgbm1 \
        libdbus-1-3 \
        libfontconfig1 libfreetype6 \
        libx11-6 libxext6 libxrender1 libxcb1 libxkbcommon0 libxkbcommon-x11-0 \
        libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
        libxcb-render-util0 libxcb-shape0 libxcb-xkb1 libxcb-sync1 libxcb-xfixes0 \
        libxcb-glx0 libxcb-shm0 libxcb-present0 libxcb-dri2-0 libxcb-dri3-0 \
        libxcomposite1 libxdamage1 libxrandr2 libxi6 libxtst6 libxfixes3 \
        libnss3 libnspr4 libcups2 libasound2 libpci3 libxss1 \
        libatomic1 libpulse0 \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

# Pinned uv, verified against its published checksum.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) triple=x86_64-unknown-linux-gnu ;; \
      arm64) triple=aarch64-unknown-linux-gnu ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/astral-sh/uv/releases/download/${UV_VERSION}"; \
    asset="uv-${triple}.tar.gz"; \
    cd /tmp; \
    curl -LsSf -O "${base}/${asset}"; \
    curl -LsSf -O "${base}/${asset}.sha256"; \
    sha256sum -c "${asset}.sha256"; \
    tar -xzf "${asset}" -C /usr/local/bin --strip-components=1 \
        "uv-${triple}/uv" "uv-${triple}/uvx"; \
    rm -f "${asset}" "${asset}.sha256"; \
    uv --version

# Unprivileged build user. container-build-linux.sh overrides the effective
# UID at run time with --user "$(id -u):$(id -g)", so output under the
# bind-mounted /work always ends up owned by you, not root, on any host.
# That overridden UID has no /etc/passwd entry, so $HOME (set at run time to
# this directory) has to be writable by anyone, not just uid 1000 - hence
# chmod a+rwX rather than a chown. Same story for the uv cache: a fresh named
# volume mounted at /home/builder/.cache/uv is initialized by Docker from
# whatever is already here in the image, permissions included, on first use.
RUN useradd -m -u 1000 builder && \
    mkdir -p /home/builder/.cache/uv && \
    chmod -R a+rwX /home/builder

USER builder
WORKDIR /work
