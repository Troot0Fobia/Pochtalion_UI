# Top-level runtime dependencies only.
#
# This file is human-edited. The actual install set is the fully-pinned,
# hash-verified lock files, regenerated by build/lock.sh:
#
#   requirements-linux.txt
#   requirements-windows.txt
#
# Never `pip install` this file directly for a build — use the locks with
# `pip install --require-hashes -r requirements-<os>.txt`.
#
# Versions below are the known-good set carried over from the 3.10 line
# (the migration baseline). Bump them deliberately, one axis at a time,
# re-running build/lock.sh and re-testing.

aiosqlite==0.21.0
cryptg==0.5.0.post0     # optional Telethon speed-up; compiled C ext, must be bundled
pillow==12.1.0          # qrcode's default image factory renders through PIL
platformdirs==4.11.8
puremagic==1.29
PyQt6==6.9.1            # Qt stack versions are locked together on purpose
PyQt6-Qt6==6.9.1        # the bundled Qt binaries — pin exact, it's ~200 MB of blobs
PyQt6-WebEngine==6.9.0
PyQt6-WebEngine-Qt6==6.9.1
pytz==2025.2
qasync==0.27.1
qrcode==8.2
Telethon==1.40.0
tzlocal==5.3.1
